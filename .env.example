# このファイルを .env にコピーして編集する。
#   Copy-Item .env.example .env
#
# .env は Docker Compose が読み、コンテナの中に環境変数として渡す。
# ホスト側（PowerShell）には何も設定されないので、ホストで動くスクリプトの設定は
# ユーザー環境変数に置く（末尾の「ホスト側で設定するもの」を参照）。

# --- Database ---------------------------------------------------------------
# POSTGRES_PASSWORD と DATABASE_URL の中のパスワードは同じ値に揃えること。
# 記号を含めると DATABASE_URL のURLエンコードが必要になるため、英数字を推奨。
#   生成例: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://dashboard:change_me@db:5432/dashboard

# --- Django -----------------------------------------------------------------
# DJANGO_SECRET_KEY は必須。未設定だと DJANGO_DEBUG=False では起動しない。
#   生成例: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tokyo
CORS_ALLOWED_ORIGINS=http://localhost:8770

# ダッシュボードのURL。MCPの許可ホスト・許可オリジンの既定値がここから導出される。
# ポートを変えるときは DASHBOARD_PORT と、この下の 8770 をすべて揃えること
# （scripts/setup.ps1 -Port を使えば自動で揃う）。
DASHBOARD_PORT=8770
DASHBOARD_URL=http://localhost:8770

# React UI が利用する web スコープのAPIキー。
# 手順5の create_api_key で発行した平文を設定し、proxyを再作成する。
# nginxだけが読み、ブラウザのJavaScriptやwebイメージには埋め込まれない。
DASHBOARD_WEB_API_KEY=change_me

# --- MCP transport security -------------------------------------------------
# MCP SDK の DNS リバインディング対策。許可されていない Host は 421 で拒否される。
# 未設定なら DASHBOARD_URL と CORS_ALLOWED_ORIGINS から自動生成される。
# ★ ワイルドカードなどで広げないこと。保護が無意味になる。
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:8770,localhost,localhost:8770,api,api:8000
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8770,http://localhost:8770

# --- 任意: Discord 通知 ---------------------------------------------------
# 使うときは COMPOSE_PROFILES=discord を有効にする（README「Discord に通知する」参照）。
# Bot トークン・チャンネル ID・メンション・朝のまとめの時刻・通知の ON/OFF は
# ダッシュボードの「設定」画面で入力する（ここには書かない）。
# COMPOSE_PROFILES=discord
# discord スコープの APIキー。bot が設定と通知の材料を API から読むときに使う。
# DASHBOARD_DISCORD_API_KEY=

# --- 任意: レート制限 -------------------------------------------------------
# 外部からアクセスできる場所に置く場合は見直すこと。
# THROTTLE_ANON=30/min
# THROTTLE_USER=600/min
# API_KEY_FAILURE_LIMIT=10
# API_KEY_FAILURE_WINDOW_SEC=300

# =============================================================================
# ホスト側で設定するもの（このファイルには書かない）
# =============================================================================
# 発行したAPIキーは利用先ごとに分けて渡す。
#
#   mcp スコープ      -> claude mcp add の --header に埋め込む
#       claude mcp add --scope user --transport http dashboard `
#         http://127.0.0.1:8770/mcp --header "Authorization: Api-Key <キー>"
#
#   pipeline スコープ -> Windows のユーザー環境変数（scripts/dashboard_client.ps1 が読む）
#       [Environment]::SetEnvironmentVariable('DASHBOARD_URL', 'http://127.0.0.1:8770', 'User')
#       [Environment]::SetEnvironmentVariable('DASHBOARD_API_KEY_PIPELINE', '<キー>', 'User')
#
#   web スコープ      -> 上の DASHBOARD_WEB_API_KEY（nginxがAPIリクエストへ付与）
